rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user has exclusive access to their own data tree.
    // No user can read, write, or query documents under another user's path.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Match all subcollections: history, conversations, resume, skill_gap, roadmap
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
