# Career Advisor — environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# LLM Provider: groq (default) | gemini
LLM_PROVIDER=groq

# Groq API key (get free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq-latest

# Google Gemini API key (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Hugging Face token (free — https://huggingface.co/settings/tokens, "read"
# scope is enough). Used to call HF's hosted Inference API for embeddings,
# instead of loading sentence-transformers/torch into this process locally.
# Required for RAG (chat grounded in a PDF) and for the document upload
# feature; the rest of the app works without it.
HF_TOKEN=your_huggingface_token_here

# RAG pipeline tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CONTEXT_DOCS=3
RELEVANCE_SCORE_THRESHOLD=0.35

# Storage
CHROMA_PERSIST_DIR=chroma_db
DEFAULT_DOCUMENT_PATH=Career_Advisor_Guide_2025.pdf
# Index DEFAULT_DOCUMENT_PATH on startup when no vector store exists yet, so
# retrieval works on a fresh checkout. Requires HF_TOKEN (see above) since
# embeddings now run via HF's hosted API rather than a local model. Set false
# to start un-grounded instead, or if you haven't set HF_TOKEN yet.
AUTO_INDEX_DEFAULT_DOCUMENT=true

# Scope
# Refuse anything outside career advice ("who is the PM of India", "list Indian
# actors") instead of answering it. Set false to allow general questions.
STRICT_CAREER_ONLY=true

# Limits
MAX_UPLOAD_SIZE_MB=15
MAX_QUERY_LENGTH=2000

# Conversation memory window (number of prior turns kept per session)
MAX_HISTORY_TURNS=6

# External call resilience
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- LangSmith (tracing / evaluation) ---
# Get a key at https://smith.langchain.com/. Leave LANGSMITH_TRACING=false to
# run fully offline (default) — nothing else below is required in that case.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-advisor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- MCP server (mcp_server.py) ---
MCP_SERVER_NAME=career-advisor
MCP_TRANSPORT=stdio

# --- Job Search Tool ---
# Optional: live search via Adzuna (https://developer.adzuna.com/). Without
# these, the Job Search Tool falls back to a small bundled sample dataset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_SEARCH_COUNTRY=us
JOB_SEARCH_DEFAULT_LIMIT=10

# --- Resume Analyzer ---
MAX_RESUME_SIZE_MB=10
